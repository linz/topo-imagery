[MASTER]
# Test helpers are imported by bare name. Mirror pytest's `pythonpath`
init-hook = "import sys; sys.path += ['packages/geoprocessor-gdal/test', 'packages/geoprocessor-gdal/test/tile', 'packages/geoprocessor-stac/test']"
disable =
        duplicate-code,
        invalid-name,
        missing-class-docstring,
        missing-module-docstring,
        missing-function-docstring,
        broad-exception-raised,

[FORMAT]
max-line-length=127
[MISCELLANEOUS]
notes=XXX
[SIMILARITIES]
min-similarity-lines=4
ignore-comments=yes
ignore-docstrings=yes
ignore-imports=yes
[DESIGN]
max-args = 8
